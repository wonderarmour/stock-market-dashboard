# 이 파일을 .env 로 복사한 뒤 값을 채워 주세요. (.env 는 git에 올리지 않아요)
PORT=3000

# OpenAI API 키 (AI 채팅 · 대응 시나리오 · 뉴스 브리핑 · 과거 뉴스 요약에 사용)
OPENAI_API_KEY=sk-...

# 선택: 텔레그램 이미지 스크랩 기본 채널 (쉼표 구분, @ 없이)
# TELEGRAM_CHANNELS=wowtv_official,FastStockNews

# 선택: 리밸런싱 알림용 텔레그램 봇 (README 10장 참고)
# 1) 텔레그램에서 @BotFather 에게 /newbot → 토큰 받기
# 2) 만든 봇에게 아무 메시지나 보낸 뒤 https://api.telegram.org/bot<토큰>/getUpdates 에서 chat.id 확인
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
