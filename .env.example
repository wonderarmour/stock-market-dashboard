# 이 파일을 .env 로 복사한 뒤 값을 채워 주세요. (.env 는 git에 올리지 않아요)
PORT=3000

# 외부(클라우드)에 띄울 때 — README 12장
# APP_PASSWORD=긴비밀번호        # 설정하면 모든 화면·API에 로그인 필요. 로컬 전용이면 비워 두기
# SESSION_SECRET=임의의긴문자열   # 로그인 쿠키 서명용 (없으면 APP_PASSWORD 로 대체)
# PUBLIC_URL=https://34-64-1-2.sslip.io   # 공개 주소. 카카오 리다이렉트 URI·메시지 링크에 사용

# OpenAI API 키 (AI 채팅 · 대응 시나리오 · 뉴스 브리핑 · 과거 뉴스 요약에 사용)
OPENAI_API_KEY=sk-...

# 선택: 텔레그램 이미지 스크랩 기본 채널 (쉼표 구분, @ 없이)
# TELEGRAM_CHANNELS=wowtv_official,FastStockNews

# 선택: 리밸런싱 알림용 텔레그램 봇 (README 10장 참고)
# 1) 텔레그램에서 @BotFather 에게 /newbot → 토큰 받기
# 2) 만든 봇에게 아무 메시지나 보낸 뒤 https://api.telegram.org/bot<토큰>/getUpdates 에서 chat.id 확인
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# 선택: 카카오톡 "나에게 보내기" 알림 (README 11장 참고)
# developers.kakao.com → 내 애플리케이션 → 앱 키의 "REST API 키"
# 카카오 로그인 활성화, 동의항목 talk_message, Redirect URI http://localhost:3000/auth/kakao/callback 등록
# KAKAO_REST_KEY=...
# KAKAO_CLIENT_SECRET=...   (REST API 키 > 클라이언트 시크릿이 "사용" 상태면 필수)
# KAKAO_LINK_URL=https://github.com/wonderarmour/stock-market-dashboard   (메시지 버튼 링크. 이 도메인을 콘솔 "웹 도메인"에 등록)
